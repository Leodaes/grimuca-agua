# Este archivo debe copiarse a la RAÍZ del repo con el nombre ".dockerignore"
# (el contexto de construcción es la raíz; desde infra/ no tiene efecto).

# Control de versiones y herramientas locales
.git
.gitattributes
.gitignore

# Dependencias y compilados: se generan dentro de la imagen
**/node_modules
app/dist
**/coverage
playwright-report
test-results

# Secretos y archivos de entorno: nunca entran a la imagen
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/*_ed25519*

# Lo que la imagen no necesita
**/*.log
docs
grimuca-design
insumos-tulio
pruebas
HANDOFF-*.md
README.md
