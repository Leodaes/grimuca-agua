# Grimuca Agua · variables de entorno
#
# Copia este archivo y completa los valores:
#   - En desarrollo: como `.env` en la raíz del repositorio (la API lo carga sola al arrancar).
#   - En el servidor: como el archivo de entorno del contenedor, con permisos 600.
# Nunca subas al repositorio un archivo con valores reales.

# --- Servidor ---

# Puerto donde escucha la API (también sirve el front compilado).
PUERTO=3070

# Carpeta del front compilado (`npm run build`). Si es relativa, se resuelve desde la carpeta `api/`.
DIR_ESTATICOS=../app/dist

# --- Base de datos ---

# Cadena de conexión de PostgreSQL. Obligatoria para arrancar y para migrar.
# Formato: postgres://USUARIO:CLAVE@HOST:5432/BASE
DATABASE_URL=

# --- Panel del operador ---

# PIN para entrar al panel (/operador y /comercio) como el comercio "grimuca". Si queda vacío, nadie puede entrar.
PIN_OPERADOR=

# --- Red de comercios (docs/decisiones/contrato-red.md) ---

# PIN de cada comercio aliado, en JSON con el id del comercio: {"aliado-lara":"...","aliado-aragua":"..."}
# Opcional. Si queda vacío, solo entra Grimuca. Si el JSON no es válido, se ignora con un aviso al arrancar.
PINES_COMERCIOS=

# PIN de la red (/red, superadmin). Si queda vacío, nadie entra a la red.
PIN_SUPERADMIN=

# PIN del técnico de Grimuca (/tecnico). Si queda vacío, nadie entra como técnico.
PIN_TECNICO=

# Secreto para firmar la sesión del operador: texto largo y al azar, de 32 caracteres o más.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si queda vacío o tiene menos de 16 caracteres, se usa uno temporal y las sesiones se cierran en cada reinicio.
SECRETO_SESION=

# --- Lectura de la tira (servicio de visión) ---
# El servicio se llama solo desde el servidor; la clave nunca llega al navegador.

# Dirección completa del servicio de visión al que se envía la foto.
VISION_API_URL=

# Clave del servicio de visión. Si queda vacía, la lectura va simulada.
VISION_API_KEY=

# Identificador del modelo de visión.
VISION_MODELO=

# Opcional. Cabeceras adicionales que exija el servicio, como un objeto JSON en una sola línea
# (por ejemplo, la cabecera de versión de su API). Vacío = ninguna.
VISION_CABECERAS=

# Opcional. 1 = obliga al servicio a responder con la herramienta de lectura (solo si el modelo lo admite).
VISION_FORZAR_HERRAMIENTA=0

# 1 = no se llama al servicio de visión: toda foto devuelve una lectura de ejemplo fija (demo y pruebas sin red).
# 0 = se usa el servicio de visión configurado arriba.
LECTOR_SIMULADO=0

# --- Catálogo ---

# Opcional y en desuso con el catálogo actual. Marcas que no se sugieren, separadas por comas. Vacío = todas.
MARCAS_EXCLUIDAS=
